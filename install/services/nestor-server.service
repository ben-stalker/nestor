[Unit]
Description=Nestor Household Dashboard Server
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{NESTOR_USER}}
WorkingDirectory={{INSTALL_DIR}}
ExecStart=/usr/local/bin/node {{INSTALL_DIR}}/server/dist/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
Environment=NESTOR_PORT=3000
EnvironmentFile=-/etc/nestor.env

[Install]
WantedBy=multi-user.target
